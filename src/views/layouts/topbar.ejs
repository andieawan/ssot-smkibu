<header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between shadow-sm">
  <div>
    <h1 class="text-xl font-bold text-gray-800"><%= title %></h1>
    <p class="text-xs text-gray-500 mt-0.5">
      <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <span class="text-sm text-gray-600">Halo, <strong><%= user ? user.nama : '' %></strong></span>
    <a href="/logout" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-3 py-1.5 rounded-lg transition-colors font-medium">Keluar</a>
  </div>
</header>
