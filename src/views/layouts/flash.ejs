<% if (flash_success && flash_success.length > 0) { %>
  <% flash_success.forEach(msg => { %>
  <div class="flash-msg fixed top-4 right-4 z-50 bg-green-500 text-white px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 max-w-sm">
    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    <span class="text-sm font-medium"><%- msg %></span>
  </div>
  <% }) %>
<% } %>
<% if (flash_error && flash_error.length > 0) { %>
  <% flash_error.forEach(msg => { %>
  <div class="flash-msg fixed top-4 right-4 z-50 bg-red-500 text-white px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 max-w-sm">
    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    <span class="text-sm font-medium"><%- msg %></span>
  </div>
  <% }) %>
<% } %>
<% if (flash_info && flash_info.length > 0) { %>
  <% flash_info.forEach(msg => { %>
  <div class="flash-msg fixed top-4 right-4 z-50 bg-blue-500 text-white px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 max-w-sm">
    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <span class="text-sm font-medium"><%- msg %></span>
  </div>
  <% }) %>
<% } %>
