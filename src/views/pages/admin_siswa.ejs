<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-5">

      <!-- Actions -->
      <div class="flex flex-wrap gap-3 items-center justify-between">
        <form method="GET" action="/admin/siswa" class="flex gap-3 flex-wrap">
          <input type="text" name="search" value="<%= search %>" placeholder="Cari nama/NISN..."
            class="px-4 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <select name="kelas" class="px-4 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="">Semua Kelas</option>
            <% classes.forEach(k => { %>
            <option value="<%= k.id %>" <%= kelas == k.id ? 'selected' : '' %>><%= k.nama_kelas %></option>
            <% }) %>
          </select>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-medium hover:bg-indigo-700">Cari</button>
        </form>
        <div class="flex gap-2">
          <a href="/admin/siswa/export" class="text-xs bg-green-50 text-green-700 hover:bg-green-100 border border-green-200 px-3 py-2 rounded-xl font-medium">📥 Export Excel</a>
          <button onclick="openModal('modal-import')" class="text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 px-3 py-2 rounded-xl font-medium">📤 Import Excel</button>
          <button onclick="openModal('modal-tambah-siswa')" class="text-xs bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-2 rounded-xl font-medium">+ Tambah Siswa</button>
        </div>
      </div>

      <!-- Table -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
          <h3 class="font-bold text-gray-800">Data Siswa (<%= total_count %>)</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-100">
              <tr>
                <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">NISN</th>
                <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nama</th>
                <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Kelas</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Zona</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Poin</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">SP</th>
                <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% if (students.length === 0) { %>
              <tr><td colspan="7" class="px-5 py-8 text-center text-gray-400">Tidak ada data siswa</td></tr>
              <% } else { %>
              <% students.forEach(s => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3 font-mono text-xs text-gray-600"><%= s.nisn %></td>
                <td class="px-5 py-3">
                  <a href="/siswa/<%= s.id %>" class="font-semibold text-gray-800 hover:text-indigo-600"><%= s.nama %></a>
                </td>
                <td class="px-5 py-3 text-gray-600"><%= s.nama_kelas || '-' %></td>
                <td class="px-5 py-3 text-center"><span class="badge-<%= s.status_warna %>"><%= s.status_warna %></span></td>
                <td class="px-5 py-3 text-center font-semibold text-gray-700"><%= s.total_poin %></td>
                <td class="px-5 py-3 text-center">
                  <% if (s.status_sp !== 'tidak_ada') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700"><%= s.status_sp.toUpperCase() %></span>
                  <% } else { %><span class="text-gray-300 text-xs">-</span><% } %>
                </td>
                <td class="px-5 py-3">
                  <div class="flex gap-2">
                    <a href="/siswa/<%= s.id %>" class="text-xs bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-2 py-1 rounded-lg">Detail</a>
                    <form action="/admin/siswa/hapus/<%= s.id %>" method="POST" onsubmit="return confirm('Hapus siswa <%= s.nama %>?')">
                      <button type="submit" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded-lg">Hapus</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
        <!-- Pagination -->
        <% if (totalPages > 1) { %>
        <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">
          <span class="text-sm text-gray-500">Halaman <%= page %> dari <%= totalPages %></span>
          <div class="flex gap-2">
            <% if (page > 1) { %><a href="/admin/siswa?page=<%= page-1 %>&search=<%= search %>&kelas=<%= kelas %>" class="px-3 py-1.5 text-sm bg-gray-100 hover:bg-gray-200 rounded-lg">← Prev</a><% } %>
            <% if (page < totalPages) { %><a href="/admin/siswa?page=<%= page+1 %>&search=<%= search %>&kelas=<%= kelas %>" class="px-3 py-1.5 text-sm bg-indigo-600 text-white hover:bg-indigo-700 rounded-lg">Next →</a><% } %>
          </div>
        </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Modal Tambah Siswa -->
<div id="modal-tambah-siswa" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-lg mx-4 shadow-2xl max-h-screen overflow-y-auto">
    <h3 class="font-bold text-gray-800 mb-4">Tambah Siswa Baru</h3>
    <form action="/admin/siswa/tambah" method="POST" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="block text-sm font-semibold text-gray-700 mb-1">NISN (10 digit) <span class="text-red-500">*</span></label>
          <input type="text" name="nisn" maxlength="10" pattern="\d{10}" required placeholder="1234567890"
            class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div class="col-span-2">
          <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Lengkap <span class="text-red-500">*</span></label>
          <input type="text" name="nama" required class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Kelas</label>
          <select name="class_id" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="">-- Pilih Kelas --</option>
            <% classes.forEach(k => { %><option value="<%= k.id %>"><%= k.nama_kelas %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Jenis Kelamin</label>
          <select name="jenis_kelamin" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="L">Laki-laki</option>
            <option value="P">Perempuan</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Orang Tua</label>
          <input type="text" name="nama_ortu" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">No HP Orang Tua</label>
          <input type="text" name="no_hp_ortu" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm">Simpan</button>
        <button type="button" onclick="closeModal('modal-tambah-siswa')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Import Excel -->
<div id="modal-import" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-2">Import Data Siswa dari Excel</h3>
    <p class="text-xs text-gray-500 mb-4">Format kolom: <strong>nisn, nama, nama_kelas, jenis_kelamin</strong>. NISN duplikat akan dilewati otomatis.</p>
    <form action="/admin/siswa/import" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">File Excel (.xlsx, maks 5MB)</label>
        <input type="file" name="file_excel" accept=".xlsx" required
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-xl text-sm">Import</button>
        <button type="button" onclick="closeModal('modal-import')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
