<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-6">

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/admin/siswa" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover block">
          <div class="text-3xl font-black text-indigo-600"><%= stats.totalSiswa %></div>
          <div class="text-sm text-gray-500 mt-1">Total Siswa</div>
        </a>
        <a href="/admin/staf" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover block">
          <div class="text-3xl font-black text-blue-600"><%= stats.totalStaf %></div>
          <div class="text-sm text-gray-500 mt-1">Total Staf</div>
        </a>
        <a href="/admin/kelas" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover block">
          <div class="text-3xl font-black text-green-600"><%= stats.totalKelas %></div>
          <div class="text-sm text-gray-500 mt-1">Total Kelas</div>
        </a>
        <a href="/admin/kategori" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover block">
          <div class="text-3xl font-black text-orange-600"><%= stats.totalKategori %></div>
          <div class="text-sm text-gray-500 mt-1">Kategori Pelanggaran</div>
        </a>
      </div>

      <!-- Quick Links -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/admin/siswa" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover flex items-center gap-4">
          <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <div>
            <div class="font-bold text-gray-800">Manajemen Siswa</div>
            <div class="text-xs text-gray-500">CRUD, Import & Export Excel</div>
          </div>
        </a>
        <a href="/admin/staf" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover flex items-center gap-4">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <div>
            <div class="font-bold text-gray-800">Manajemen Staf</div>
            <div class="text-xs text-gray-500">Kelola akun pengguna sistem</div>
          </div>
        </a>
        <a href="/admin/kelas" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover flex items-center gap-4">
          <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <div>
            <div class="font-bold text-gray-800">Manajemen Kelas</div>
            <div class="text-xs text-gray-500">Tambah, edit, hapus kelas</div>
          </div>
        </a>
        <a href="/admin/kategori" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover flex items-center gap-4">
          <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 10V5a2 2 0 012-2z"/></svg>
          </div>
          <div>
            <div class="font-bold text-gray-800">Kategori Pelanggaran</div>
            <div class="text-xs text-gray-500">Kelola jenis & bobot pelanggaran</div>
          </div>
        </a>
      </div>

      <!-- Reset Database (Super Admin Only) -->
      <% if (user && user.role === 'super_admin') { %>
      <div class="bg-red-50 border border-red-200 rounded-2xl p-5">
        <h3 class="font-bold text-red-800 mb-2">⚠️ Zona Berbahaya - Reset Database</h3>
        <p class="text-sm text-red-700 mb-4">Tindakan ini akan menghapus SEMUA data siswa, insiden, SP, dan tugas. Tidak dapat dibatalkan!</p>
        <button onclick="openModal('modal-reset')" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition-colors">
          Reset Total Database
        </button>
      </div>
      <% } %>

    </main>
  </div>
</div>

<!-- Modal Reset -->
<div id="modal-reset" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="font-bold text-red-700 mb-2">⚠️ Konfirmasi Reset Database</h3>
    <p class="text-sm text-gray-600 mb-4">Ketik <strong>RESET SINERGICARE</strong> untuk mengkonfirmasi penghapusan semua data.</p>
    <form action="/admin/reset" method="POST" class="space-y-4">
      <input type="text" name="konfirmasi" placeholder="RESET SINERGICARE" required
        class="w-full px-4 py-3 border border-red-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 rounded-xl text-sm">Reset Sekarang</button>
        <button type="button" onclick="closeModal('modal-reset')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
