<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-5">

      <!-- Statistik Ringkasan -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 text-center">
          <div class="text-2xl font-black text-gray-800"><%= stats.total_siswa %></div>
          <div class="text-xs text-gray-500 mt-1">Total Siswa</div>
        </div>
        <div class="bg-green-50 rounded-2xl p-4 shadow-sm border border-green-100 text-center">
          <div class="text-2xl font-black text-green-700"><%= stats.hijau %></div>
          <div class="text-xs text-green-600 mt-1">Zona Hijau</div>
        </div>
        <div class="bg-yellow-50 rounded-2xl p-4 shadow-sm border border-yellow-100 text-center">
          <div class="text-2xl font-black text-yellow-700"><%= stats.kuning %></div>
          <div class="text-xs text-yellow-600 mt-1">Zona Kuning</div>
        </div>
        <div class="bg-red-50 rounded-2xl p-4 shadow-sm border border-red-100 text-center">
          <div class="text-2xl font-black text-red-700"><%= stats.merah %></div>
          <div class="text-xs text-red-600 mt-1">Zona Merah</div>
        </div>
        <div class="bg-purple-50 rounded-2xl p-4 shadow-sm border border-purple-100 text-center">
          <div class="text-2xl font-black text-purple-700"><%= stats.probation %></div>
          <div class="text-xs text-purple-600 mt-1">Probation</div>
        </div>
      </div>

      <!-- Matriks Kelas -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
          <h3 class="font-bold text-gray-800">Matriks Kontrol Ketertiban Per Kelas</h3>
          <p class="text-xs text-gray-500 mt-1">Data read-only untuk monitoring Ketua Jurusan</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-100">
              <tr>
                <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Kelas</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Total Siswa</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-green-600 uppercase">Hijau</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-yellow-600 uppercase">Kuning</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-red-600 uppercase">Merah</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Total Insiden</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Risiko</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% if (matriksKelas.length === 0) { %>
              <tr><td colspan="7" class="px-5 py-8 text-center text-gray-400">Belum ada data kelas</td></tr>
              <% } else { %>
              <% matriksKelas.forEach(k => { %>
              <%
                const risikoLevel = k.zona_merah > 0 ? 'tinggi' : k.zona_kuning > 0 ? 'sedang' : 'rendah';
                const risikoClass = risikoLevel === 'tinggi' ? 'bg-red-100 text-red-700' : risikoLevel === 'sedang' ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700';
              %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3 font-semibold text-gray-800"><%= k.nama_kelas %></td>
                <td class="px-5 py-3 text-center text-gray-700"><%= k.total_siswa %></td>
                <td class="px-5 py-3 text-center">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-700 font-bold text-sm"><%= k.zona_hijau %></span>
                </td>
                <td class="px-5 py-3 text-center">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-yellow-100 text-yellow-700 font-bold text-sm"><%= k.zona_kuning %></span>
                </td>
                <td class="px-5 py-3 text-center">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-red-100 text-red-700 font-bold text-sm"><%= k.zona_merah %></span>
                </td>
                <td class="px-5 py-3 text-center text-gray-700"><%= k.total_insiden %></td>
                <td class="px-5 py-3 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= risikoClass %>">
                    <%= risikoLevel.charAt(0).toUpperCase() + risikoLevel.slice(1) %>
                  </span>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Siswa Berisiko Tinggi -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
          <h3 class="font-bold text-gray-800">Siswa Vokasi Berisiko Tinggi (Read-Only)</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-100">
              <tr>
                <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Siswa</th>
                <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Kelas</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Zona</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Poin</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Insiden</th>
                <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Status SP</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% if (siswaBerisiko.length === 0) { %>
              <tr><td colspan="6" class="px-5 py-8 text-center text-gray-400">Tidak ada siswa berisiko</td></tr>
              <% } else { %>
              <% siswaBerisiko.forEach(s => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3">
                  <div class="font-semibold text-gray-800"><%= s.nama %></div>
                  <div class="text-xs text-gray-400"><%= s.nisn %></div>
                </td>
                <td class="px-5 py-3 text-gray-600"><%= s.nama_kelas || '-' %></td>
                <td class="px-5 py-3 text-center"><span class="badge-<%= s.status_warna %>"><%= s.status_warna %></span></td>
                <td class="px-5 py-3 text-center font-semibold text-gray-700"><%= s.total_poin %></td>
                <td class="px-5 py-3 text-center text-gray-600"><%= s.total_insiden %></td>
                <td class="px-5 py-3 text-center">
                  <% if (s.status_sp !== 'tidak_ada') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700"><%= s.status_sp.toUpperCase() %></span>
                  <% } else { %><span class="text-gray-400 text-xs">-</span><% } %>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>
</div>
<%- include('../layouts/footer') %>
