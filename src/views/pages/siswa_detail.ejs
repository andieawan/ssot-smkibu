<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-5">

      <!-- Profil -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div class="flex items-center gap-5">
            <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-3xl font-black text-white
              <%= siswa.status_warna === 'merah' ? 'bg-red-500' : siswa.status_warna === 'kuning' ? 'bg-yellow-500' : 'bg-green-500' %>">
              <%= siswa.nama.charAt(0) %>
            </div>
            <div>
              <h2 class="text-2xl font-black text-gray-800"><%= siswa.nama %></h2>
              <div class="text-gray-500 mt-1"><%= siswa.nisn %> &bull; <%= siswa.nama_kelas || 'Belum ada kelas' %></div>
              <div class="flex gap-2 mt-2 flex-wrap">
                <% const badge = getBadgeWarna(siswa.status_warna); %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= badge.class %>"><%= badge.label %></span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700"><%= siswa.total_poin %> poin akumulasi</span>
                <% if (siswa.status_sp !== 'tidak_ada') { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700"><%= siswa.status_sp.toUpperCase() %></span>
                <% } %>
                <% if (siswa.is_probation) { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-700">Probation s/d <%= new Date(siswa.probation_end).toLocaleDateString('id-ID') %></span>
                <% } %>
              </div>
            </div>
          </div>
          <div class="flex gap-2 flex-wrap">
            <a href="/cetak/riwayat/<%= siswa.id %>" target="_blank" class="text-xs bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-200 px-3 py-2 rounded-xl font-medium">📄 Cetak Riwayat</a>
            <a href="/cetak/pernyataan/<%= siswa.id %>" target="_blank" class="text-xs bg-green-50 text-green-700 hover:bg-green-100 border border-green-200 px-3 py-2 rounded-xl font-medium">📝 Surat Pernyataan</a>
          </div>
        </div>

        <!-- Info Detail -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-5 pt-5 border-t border-gray-100">
          <div><div class="text-xs text-gray-400 mb-1">Jenis Kelamin</div><div class="font-medium text-gray-700"><%= siswa.jenis_kelamin === 'L' ? 'Laki-laki' : 'Perempuan' %></div></div>
          <div><div class="text-xs text-gray-400 mb-1">Nama Orang Tua</div><div class="font-medium text-gray-700"><%= siswa.nama_ortu || '-' %></div></div>
          <div><div class="text-xs text-gray-400 mb-1">No HP Orang Tua</div><div class="font-medium text-gray-700"><%= siswa.no_hp_ortu || '-' %></div></div>
          <div><div class="text-xs text-gray-400 mb-1">Level Eskalasi</div><div class="font-medium text-gray-700"><%= siswa.level_eskalasi %></div></div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <!-- Riwayat Insiden -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
          <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <h3 class="font-bold text-gray-800">Riwayat Insiden (<%= incidents.length %>)</h3>
            <a href="/jurnal/tambah" class="text-xs bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-3 py-1.5 rounded-lg font-medium">+ Catat</a>
          </div>
          <div class="divide-y divide-gray-50 max-h-96 overflow-y-auto">
            <% if (incidents.length === 0) { %>
            <div class="px-5 py-8 text-center text-gray-400 text-sm">Belum ada riwayat insiden</div>
            <% } else { %>
            <% incidents.forEach(inc => { %>
            <div class="px-5 py-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <div class="font-medium text-sm text-gray-800"><%= inc.nama_kejadian %></div>
                  <div class="text-xs text-gray-500 mt-0.5"><%= new Date(inc.tanggal_kejadian).toLocaleDateString('id-ID') %> &bull; <%= inc.lokasi_kejadian || '-' %></div>
                  <% if (inc.catatan) { %><div class="text-xs text-gray-400 mt-1"><%= inc.catatan %></div><% } %>
                  <div class="text-xs text-gray-400">Pelapor: <%= inc.nama_pelapor || '-' %></div>
                </div>
                <% const bb = getBadgeBobot(inc.bobot_risiko); %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium flex-shrink-0 <%= bb.class %>"><%= inc.bobot_risiko %> (<%= bb.poin %>)</span>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Tugas & SP -->
        <div class="space-y-4">
          <!-- Tugas Konsekuensi -->
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
            <div class="px-5 py-4 border-b border-gray-100">
              <h3 class="font-bold text-gray-800">Tugas Konsekuensi (<%= tugas.length %>)</h3>
            </div>
            <div class="divide-y divide-gray-50 max-h-48 overflow-y-auto">
              <% if (tugas.length === 0) { %>
              <div class="px-5 py-6 text-center text-gray-400 text-sm">Belum ada tugas</div>
              <% } else { %>
              <% tugas.forEach(t => { %>
              <div class="px-5 py-3 flex items-start justify-between gap-2">
                <div>
                  <div class="text-sm text-gray-700"><%= t.deskripsi_tugas %></div>
                  <% if (t.nama_pendamping) { %><div class="text-xs text-gray-400 mt-1">Pendamping: <%= t.nama_pendamping %></div><% } %>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold flex-shrink-0
                  <%= t.status_tugas === 'selesai' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
                  <%= t.status_tugas %>
                </span>
              </div>
              <% }) %>
              <% } %>
            </div>
          </div>

          <!-- SP Records -->
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
            <div class="px-5 py-4 border-b border-gray-100">
              <h3 class="font-bold text-gray-800">Surat Peringatan (<%= spRecords.length %>)</h3>
            </div>
            <div class="divide-y divide-gray-50 max-h-48 overflow-y-auto">
              <% if (spRecords.length === 0) { %>
              <div class="px-5 py-6 text-center text-gray-400 text-sm">Belum ada SP</div>
              <% } else { %>
              <% spRecords.forEach(sp => { %>
              <div class="px-5 py-3 flex items-center justify-between gap-2">
                <div>
                  <span class="font-bold text-sm text-gray-800"><%= sp.jenis_sp.toUpperCase() %></span>
                  <div class="text-xs text-gray-500 mt-0.5"><%= new Date(sp.tanggal_dibuat).toLocaleDateString('id-ID') %></div>
                  <div class="text-xs text-gray-400 truncate max-w-xs"><%= sp.alasan %></div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold
                    <%= sp.status_approval === 'disetujui' ? 'bg-green-100 text-green-700' : sp.status_approval === 'ditolak' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>">
                    <%= sp.status_approval %>
                  </span>
                  <% if (sp.status_approval === 'disetujui') { %>
                  <a href="/cetak/sp/<%= sp.id %>" target="_blank" class="text-xs bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-2 py-1 rounded-lg">Cetak</a>
                  <% } %>
                </div>
              </div>
              <% }) %>
              <% } %>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>
<%- include('../layouts/footer') %>
