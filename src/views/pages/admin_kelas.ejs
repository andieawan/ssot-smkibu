<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-5">
      <div class="flex justify-between items-center">
        <p class="text-sm text-gray-500">Total: <strong><%= classes.length %></strong> kelas</p>
        <button onclick="openModal('modal-tambah-kelas')" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold">+ Tambah Kelas</button>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b border-gray-100">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nama Kelas</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Jumlah Siswa</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <% if (classes.length === 0) { %>
            <tr><td colspan="3" class="px-5 py-8 text-center text-gray-400">Belum ada kelas</td></tr>
            <% } else { %>
            <% classes.forEach(k => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-5 py-3 font-semibold text-gray-800"><%= k.nama_kelas %></td>
              <td class="px-5 py-3 text-center text-gray-600"><%= k.jumlah_siswa %></td>
              <td class="px-5 py-3">
                <div class="flex gap-2">
                  <button onclick="openEditKelas(<%= k.id %>, '<%= k.nama_kelas.replace(/'/g, "\\'") %>')"
                    class="text-xs bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-1.5 rounded-lg font-medium">Edit</button>
                  <form action="/admin/kelas/hapus/<%= k.id %>" method="POST" onsubmit="return confirm('Hapus kelas <%= k.nama_kelas %>?')">
                    <button type="submit" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 px-3 py-1.5 rounded-lg font-medium">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>

<!-- Modal Tambah Kelas -->
<div id="modal-tambah-kelas" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-sm mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-4">Tambah Kelas Baru</h3>
    <form action="/admin/kelas/tambah" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Kelas <span class="text-red-500">*</span></label>
        <input type="text" name="nama_kelas" required placeholder="Contoh: X TKJ 1"
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm">Simpan</button>
        <button type="button" onclick="closeModal('modal-tambah-kelas')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Kelas -->
<div id="modal-edit-kelas" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-sm mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-4">Edit Kelas</h3>
    <form id="form-edit-kelas" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Kelas <span class="text-red-500">*</span></label>
        <input type="text" name="nama_kelas" id="edit_nama_kelas" required
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm">Simpan</button>
        <button type="button" onclick="closeModal('modal-edit-kelas')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditKelas(id, nama) {
  document.getElementById('form-edit-kelas').action = `/admin/kelas/edit/${id}`;
  document.getElementById('edit_nama_kelas').value = nama;
  openModal('modal-edit-kelas');
}
</script>
<%- include('../layouts/footer') %>
