<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-5">

      <!-- Profil Siswa -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center text-2xl font-black text-indigo-700">
              <%= siswa.nama.charAt(0) %>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-800"><%= siswa.nama %></h2>
              <div class="text-sm text-gray-500"><%= siswa.nisn %> &bull; <%= siswa.nama_kelas || '-' %></div>
              <div class="flex gap-2 mt-2 flex-wrap">
                <span class="badge-<%= siswa.status_warna %>">Zona <%= siswa.status_warna.charAt(0).toUpperCase() + siswa.status_warna.slice(1) %></span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700"><%= siswa.total_poin %> poin</span>
                <% if (siswa.status_sp !== 'tidak_ada') { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700"><%= siswa.status_sp.toUpperCase() %></span><% } %>
                <% if (siswa.is_probation) { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">Probation s/d <%= new Date(siswa.probation_end).toLocaleDateString('id-ID') %></span><% } %>
              </div>
            </div>
          </div>
          <div class="flex gap-2">
            <a href="/cetak/riwayat/<%= siswa.id %>" target="_blank" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-xl font-medium">📄 Cetak Riwayat</a>
            <a href="/cetak/pernyataan/<%= siswa.id %>" target="_blank" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-3 py-2 rounded-xl font-medium">📝 Surat Pernyataan</a>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <!-- Riwayat Insiden -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
          <div class="px-5 py-4 border-b border-gray-100">
            <h3 class="font-bold text-gray-800">Riwayat Insiden (<%= incidents.length %>)</h3>
          </div>
          <div class="divide-y divide-gray-50 max-h-80 overflow-y-auto">
            <% if (incidents.length === 0) { %>
            <div class="px-5 py-6 text-center text-gray-400 text-sm">Belum ada insiden</div>
            <% } else { %>
            <% incidents.forEach(inc => { %>
            <div class="px-5 py-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <div class="font-medium text-sm text-gray-800"><%= inc.nama_kejadian %></div>
                  <div class="text-xs text-gray-500"><%= new Date(inc.tanggal_kejadian).toLocaleDateString('id-ID') %> &bull; <%= inc.nama_pelapor || '-' %></div>
                  <% if (inc.catatan) { %><div class="text-xs text-gray-400 mt-1"><%= inc.catatan %></div><% } %>
                </div>
                <span class="badge-<%= inc.bobot_risiko.toLowerCase() %> flex-shrink-0"><%= inc.bobot_risiko %></span>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Tugas Konsekuensi -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
          <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <h3 class="font-bold text-gray-800">Tugas Konsekuensi</h3>
            <button onclick="openModal('modal-tugas-detail')" class="text-xs bg-green-50 text-green-600 hover:bg-green-100 px-3 py-1.5 rounded-lg font-medium">+ Tambah</button>
          </div>
          <div class="divide-y divide-gray-50 max-h-80 overflow-y-auto">
            <% if (tugas.length === 0) { %>
            <div class="px-5 py-6 text-center text-gray-400 text-sm">Belum ada tugas</div>
            <% } else { %>
            <% tugas.forEach(t => { %>
            <div class="px-5 py-3">
              <div class="flex items-start justify-between gap-2">
                <div class="flex-1">
                  <div class="text-sm text-gray-700"><%= t.deskripsi_tugas %></div>
                  <% if (t.nama_pendamping) { %><div class="text-xs text-gray-500 mt-1">Pendamping: <%= t.nama_pendamping %></div><% } %>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold flex-shrink-0
                  <%= t.status_tugas === 'selesai' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
                  <%= t.status_tugas %>
                </span>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- SP Records -->
      <% if (spRecords.length > 0) { %>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
        <div class="px-5 py-4 border-b border-gray-100">
          <h3 class="font-bold text-gray-800">Riwayat Surat Peringatan</h3>
        </div>
        <div class="divide-y divide-gray-50">
          <% spRecords.forEach(sp => { %>
          <div class="px-5 py-3 flex items-center justify-between gap-3">
            <div>
              <span class="font-semibold text-sm text-gray-800"><%= sp.jenis_sp.toUpperCase() %></span>
              <div class="text-xs text-gray-500 mt-1"><%= sp.alasan %></div>
              <div class="text-xs text-gray-400">Dibuat: <%= new Date(sp.tanggal_dibuat).toLocaleDateString('id-ID') %></div>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold
                <%= sp.status_approval === 'disetujui' ? 'bg-green-100 text-green-700' : sp.status_approval === 'ditolak' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>">
                <%= sp.status_approval %>
              </span>
              <% if (sp.status_approval === 'disetujui') { %>
              <a href="/cetak/sp/<%= sp.id %>" target="_blank" class="text-xs bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-3 py-1.5 rounded-lg font-medium">Cetak SP</a>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

    </main>
  </div>
</div>

<!-- Modal Tambah Tugas -->
<div id="modal-tugas-detail" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-4">Tambah Tugas Konsekuensi</h3>
    <form action="/bk/tugas" method="POST" class="space-y-4">
      <input type="hidden" name="student_id" value="<%= siswa.id %>">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Deskripsi Tugas <span class="text-red-500">*</span></label>
        <textarea name="deskripsi_tugas" rows="3" required placeholder="Deskripsikan tugas pemulihan..."
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Guru Pendamping</label>
        <select name="penanggung_jawab" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">-- Pilih Guru --</option>
          <% guruList.forEach(g => { %>
          <option value="<%= g.id %>"><%= g.nama %></option>
          <% }) %>
        </select>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm">Simpan</button>
        <button type="button" onclick="closeModal('modal-tugas-detail')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
