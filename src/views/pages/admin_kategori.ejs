<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-5">
      <div class="flex justify-between items-center">
        <p class="text-sm text-gray-500">Total: <strong><%= categories.length %></strong> kategori</p>
        <button onclick="openModal('modal-tambah-kat')" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold">+ Tambah Kategori</button>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b border-gray-100">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nama Kejadian</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Bobot Risiko</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Deskripsi</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <% if (categories.length === 0) { %>
            <tr><td colspan="4" class="px-5 py-8 text-center text-gray-400">Belum ada kategori</td></tr>
            <% } else { %>
            <% categories.forEach(c => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-5 py-3 font-medium text-gray-800"><%= c.nama_kejadian %></td>
              <td class="px-5 py-3 text-center">
                <span class="badge-<%= c.bobot_risiko.toLowerCase() %>"><%= c.bobot_risiko %></span>
              </td>
              <td class="px-5 py-3 text-gray-500 text-xs"><%= c.deskripsi || '-' %></td>
              <td class="px-5 py-3">
                <div class="flex gap-2">
                  <button onclick="openEditKat(<%= c.id %>, '<%= c.nama_kejadian.replace(/'/g, "\\'") %>', '<%= c.bobot_risiko %>', '<%= (c.deskripsi || '').replace(/'/g, "\\'") %>')"
                    class="text-xs bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-1.5 rounded-lg font-medium">Edit</button>
                  <form action="/admin/kategori/hapus/<%= c.id %>" method="POST" onsubmit="return confirm('Hapus kategori ini?')">
                    <button type="submit" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 px-3 py-1.5 rounded-lg font-medium">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>

<!-- Modal Tambah Kategori -->
<div id="modal-tambah-kat" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-4">Tambah Kategori Pelanggaran</h3>
    <form action="/admin/kategori/tambah" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Kejadian <span class="text-red-500">*</span></label>
        <input type="text" name="nama_kejadian" required class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Bobot Risiko <span class="text-red-500">*</span></label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="bobot_risiko" value="Ringan" required class="text-blue-600">
            <span class="badge-ringan">Ringan (1 poin)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="bobot_risiko" value="Sedang" class="text-orange-600">
            <span class="badge-sedang">Sedang (3 poin)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="bobot_risiko" value="Berat" class="text-red-600">
            <span class="badge-berat">Berat (10 poin)</span>
          </label>
        </div>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Deskripsi</label>
        <textarea name="deskripsi" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm">Simpan</button>
        <button type="button" onclick="closeModal('modal-tambah-kat')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Kategori -->
<div id="modal-edit-kat" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-4">Edit Kategori</h3>
    <form id="form-edit-kat" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Kejadian <span class="text-red-500">*</span></label>
        <input type="text" name="nama_kejadian" id="edit_nama_kat" required class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Bobot Risiko</label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="bobot_risiko" value="Ringan" id="edit_ringan"><span class="badge-ringan">Ringan</span></label>
          <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="bobot_risiko" value="Sedang" id="edit_sedang"><span class="badge-sedang">Sedang</span></label>
          <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="bobot_risiko" value="Berat" id="edit_berat"><span class="badge-berat">Berat</span></label>
        </div>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Deskripsi</label>
        <textarea name="deskripsi" id="edit_deskripsi_kat" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm">Simpan</button>
        <button type="button" onclick="closeModal('modal-edit-kat')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditKat(id, nama, bobot, deskripsi) {
  document.getElementById('form-edit-kat').action = `/admin/kategori/edit/${id}`;
  document.getElementById('edit_nama_kat').value = nama;
  document.getElementById('edit_deskripsi_kat').value = deskripsi;
  document.getElementById('edit_ringan').checked = bobot === 'Ringan';
  document.getElementById('edit_sedang').checked = bobot === 'Sedang';
  document.getElementById('edit_berat').checked = bobot === 'Berat';
  openModal('modal-edit-kat');
}
</script>
<%- include('../layouts/footer') %>
