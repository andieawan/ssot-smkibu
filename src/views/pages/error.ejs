<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Error - SinergiCare</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center">
  <div class="text-center max-w-md">
    <div class="text-6xl mb-4">⚠️</div>
    <h1 class="text-2xl font-bold text-gray-800 mb-2">Terjadi Kesalahan</h1>
    <p class="text-gray-500 mb-2"><%= message || 'Internal Server Error' %></p>
    <p class="text-xs text-gray-400 mb-6">Silakan coba lagi atau hubungi administrator sistem.</p>
    <a href="/dashboard" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl font-semibold transition-colors">Kembali ke Dashboard</a>
  </div>
</body>
</html>
