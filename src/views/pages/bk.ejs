<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6 space-y-5">

      <!-- Filter -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
        <form method="GET" action="/bk" class="flex flex-wrap gap-3">
          <input type="text" name="search" value="<%= search %>" placeholder="Cari nama/NISN..."
            class="flex-1 min-w-48 px-4 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <select name="zona" class="px-4 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="">Semua Zona Aktif</option>
            <option value="kuning" <%= zona === 'kuning' ? 'selected' : '' %>>Zona Kuning</option>
            <option value="merah" <%= zona === 'merah' ? 'selected' : '' %>>Zona Merah</option>
          </select>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-medium hover:bg-indigo-700">Filter</button>
          <a href="/bk" class="px-4 py-2 bg-gray-100 text-gray-600 rounded-xl text-sm font-medium hover:bg-gray-200">Reset</a>
        </form>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <!-- Daftar Siswa Radar Aktif -->
        <div class="lg:col-span-2 space-y-3">
          <h3 class="font-bold text-gray-800">Siswa Radar Aktif (<%= total_count %>)</h3>
          <% if (students.length === 0) { %>
          <div class="bg-white rounded-2xl p-8 text-center text-gray-400 shadow-sm border border-gray-100">
            Tidak ada siswa di zona kuning/merah
          </div>
          <% } else { %>
          <% students.forEach(s => { %>
          <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 card-hover">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <a href="/bk/siswa/<%= s.id %>" class="font-bold text-gray-800 hover:text-indigo-600"><%= s.nama %></a>
                  <span class="badge-<%= s.status_warna %>">Zona <%= s.status_warna.charAt(0).toUpperCase() + s.status_warna.slice(1) %></span>
                  <% if (s.is_probation) { %><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">Probation</span><% } %>
                </div>
                <div class="text-xs text-gray-500 mt-1"><%= s.nisn %> &bull; <%= s.nama_kelas || '-' %></div>
                <div class="flex gap-4 mt-2 text-xs text-gray-600">
                  <span>📋 <%= s.total_insiden %> insiden</span>
                  <span>📌 <%= s.total_poin %> poin</span>
                  <span>✅ <%= s.tugas_proses %> tugas aktif</span>
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <a href="/bk/siswa/<%= s.id %>" class="text-xs bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-3 py-1.5 rounded-lg font-medium text-center">Detail</a>
                <button onclick="openTugasModal(<%= s.id %>, '<%= s.nama.replace(/'/g, "\\'") %>')"
                  class="text-xs bg-green-50 text-green-600 hover:bg-green-100 px-3 py-1.5 rounded-lg font-medium">+ Tugas</button>
                <button onclick="openPanggilanModal(<%= s.id %>, '<%= s.nama.replace(/'/g, "\\'") %>')"
                  class="text-xs bg-orange-50 text-orange-600 hover:bg-orange-100 px-3 py-1.5 rounded-lg font-medium">📞 Panggil</button>
              </div>
            </div>
          </div>
          <% }) %>
          <% } %>
        </div>

        <!-- Tugas Konsekuensi Aktif -->
        <div class="space-y-3">
          <h3 class="font-bold text-gray-800">Tugas Konsekuensi Aktif</h3>
          <% if (tugasAktif.length === 0) { %>
          <div class="bg-white rounded-2xl p-6 text-center text-gray-400 shadow-sm border border-gray-100 text-sm">
            Tidak ada tugas aktif
          </div>
          <% } else { %>
          <% tugasAktif.forEach(t => { %>
          <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
            <div class="font-semibold text-sm text-gray-800"><%= t.nama_siswa %></div>
            <div class="text-xs text-gray-500 mb-2"><%= t.nama_kelas || '-' %></div>
            <div class="text-xs text-gray-700 mb-2 line-clamp-2"><%= t.deskripsi_tugas %></div>
            <% if (t.nama_pendamping) { %><div class="text-xs text-gray-500 mb-2">Pendamping: <%= t.nama_pendamping %></div><% } %>
            <form action="/bk/tugas/<%= t.id %>/selesai" method="POST">
              <button type="submit" class="w-full text-xs bg-green-600 hover:bg-green-700 text-white py-1.5 rounded-lg font-medium transition-colors">
                ✓ Tandai Selesai
              </button>
            </form>
          </div>
          <% }) %>
          <% } %>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Modal Tambah Tugas -->
<div id="modal-tugas" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-4">Tambah Tugas Konsekuensi</h3>
    <form action="/bk/tugas" method="POST" class="space-y-4">
      <input type="hidden" name="student_id" id="tugas_student_id">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Siswa</label>
        <div id="tugas_siswa_nama" class="px-3 py-2 bg-indigo-50 rounded-lg text-sm font-medium text-indigo-800"></div>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Deskripsi Tugas <span class="text-red-500">*</span></label>
        <textarea name="deskripsi_tugas" rows="3" required placeholder="Deskripsikan tugas pemulihan..."
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Guru Pendamping</label>
        <select name="penanggung_jawab" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">-- Pilih Guru --</option>
          <% guruList.forEach(g => { %>
          <option value="<%= g.id %>"><%= g.nama %> (<%= g.role %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm">Simpan</button>
        <button type="button" onclick="closeModal('modal-tugas')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Panggilan Ortu -->
<div id="modal-panggilan" class="modal-overlay">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="font-bold text-gray-800 mb-4">Buat Surat Panggilan Orang Tua</h3>
    <form action="/bk/panggilan" method="POST" class="space-y-4">
      <input type="hidden" name="student_id" id="panggilan_student_id">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Siswa</label>
        <div id="panggilan_siswa_nama" class="px-3 py-2 bg-orange-50 rounded-lg text-sm font-medium text-orange-800"></div>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Tanggal Hadir <span class="text-red-500">*</span></label>
        <input type="date" name="tanggal_hadir" required
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Jam Hadir <span class="text-red-500">*</span></label>
        <input type="time" name="jam_hadir" required value="09:00"
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Keperluan</label>
        <textarea name="keperluan" rows="2" placeholder="Keperluan panggilan..."
          class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-orange-500 hover:bg-orange-600 text-white font-semibold py-2.5 rounded-xl text-sm">Buat & Cetak</button>
        <button type="button" onclick="closeModal('modal-panggilan')" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">Batal</button>
      </div>
    </form>
  </div>
</div>

<script>
function openTugasModal(id, nama) {
  document.getElementById('tugas_student_id').value = id;
  document.getElementById('tugas_siswa_nama').textContent = nama;
  openModal('modal-tugas');
}
function openPanggilanModal(id, nama) {
  document.getElementById('panggilan_student_id').value = id;
  document.getElementById('panggilan_siswa_nama').textContent = nama;
  openModal('modal-panggilan');
}
</script>
<%- include('../layouts/footer') %>
