<%- include('../layouts/header') %>
<div class="flex h-full min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 ml-64 flex flex-col min-h-screen">
    <%- include('../layouts/topbar') %>
    <%- include('../layouts/flash') %>
    <main class="flex-1 p-6">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <h2 class="text-lg font-bold text-gray-800 mb-2">Edit Insiden</h2>
          <div class="mb-5 p-3 bg-blue-50 rounded-xl border border-blue-200 text-sm text-blue-700">
            Siswa: <strong><%= incident.nama_siswa %></strong> (<%= incident.nisn %>)
          </div>

          <form action="/jurnal/edit/<%= incident.id %>" method="POST" class="space-y-5">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Kategori Pelanggaran <span class="text-red-500">*</span></label>
              <select name="category_id" required
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <% categories.forEach(c => { %>
                <option value="<%= c.id %>" <%= c.id == incident.category_id ? 'selected' : '' %>>
                  [<%= c.bobot_risiko %>] <%= c.nama_kejadian %>
                </option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Tanggal Kejadian <span class="text-red-500">*</span></label>
              <input type="date" name="tanggal_kejadian" value="<%= incident.tanggal_kejadian ? new Date(incident.tanggal_kejadian).toISOString().slice(0,10) : '' %>" required
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Lokasi Kejadian</label>
              <input type="text" name="lokasi_kejadian" value="<%= incident.lokasi_kejadian || '' %>"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Catatan</label>
              <textarea name="catatan" rows="4"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"><%= incident.catatan || '' %></textarea>
            </div>
            <div class="flex gap-3 pt-2">
              <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition-colors text-sm">Simpan Perubahan</button>
              <a href="/jurnal" class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 rounded-xl transition-colors text-sm">Batal</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include('../layouts/footer') %>
